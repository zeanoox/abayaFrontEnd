# Shopify is the backend. Create these in Shopify admin → Sales channels → Headless → your storefront.
VITE_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
# The *public* Storefront API access token (safe to ship to the browser).
VITE_SHOPIFY_STOREFRONT_TOKEN=
# Optional
VITE_SHOPIFY_API_VERSION=2026-10
# Where "Track order" sends customers (defaults to https://<store domain>/account)
VITE_SHOPIFY_ACCOUNT_URL=
